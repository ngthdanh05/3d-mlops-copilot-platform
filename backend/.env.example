# Copy to backend/.env and adjust. Never commit the real .env.
DEBUG=false
# DATABASE_URL=sqlite+aiosqlite:///./mlops.db
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# LLM — server-side only, never exposed to the frontend bundle.
# Gemini key from https://aistudio.google.com/apikey. Empty = built-in stand-in LLM.
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
