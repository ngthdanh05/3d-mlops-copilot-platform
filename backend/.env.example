# Copy to backend/.env and adjust. Never commit the real .env.
# Commented lines show the default; uncomment only what you want to change.

# --- App ---
# APP_NAME=3D-MLOps Copilot API
# APP_VERSION=0.1.0
# true = log SQL statements to the console.
DEBUG=false

# --- Database ---
# Default: backend/mlops.db. A relative path resolves against the directory
# the server is started from.
# DATABASE_URL=sqlite+aiosqlite:///./mlops.db

# --- CORS ---
# JSON list of frontend origins allowed to call the API.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# --- LLM: server-side only, never exposed to the frontend bundle ---
# Gemini key from https://aistudio.google.com/apikey. Empty = built-in stand-in LLM.
LLM_API_KEY=
# Empty = gemini-3.5-flash-lite.
LLM_MODEL=gemini-3.5-flash-lite

# --- Tests only (read from the shell, not from this file) ---
# COPILOT_LIVE=1 enables the live LLM test, which spends API quota.
